---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import CardGrid from "@components/CardGrid.astro";
import MatchupCard from "@components/MatchupCard.astro";
import MatchupFilter from "@components/MatchupFilter.astro";

import { matchups, CATEGORY_BADGE } from "@data/matchups/index";

// Static imports for each matchup's prose content
import EnchantressProse from "@data/matchups/enchantress.astro";
import ElvesProse from "@data/matchups/elves.astro";
import RockProse from "@data/matchups/rock_and_midrange.astro";
import SlighProse from "@data/matchups/sligh.astro";
import LandstillProse from "@data/matchups/landstill.astro";
import PsychatogProse from "@data/matchups/psychatog.astro";
import BWControlProse from "@data/matchups/bw_control.astro";
import RGPonzaProse from "@data/matchups/rg_ponza.astro";
import MoneyballProse from "@data/matchups/moneyball.astro";
import GoblinsProse from "@data/matchups/goblins.astro";
import TerrageddonProse from "@data/matchups/terrageddon.astro";
import StiflenoughtProse from "@data/matchups/stiflenought.astro";
import MirrorProse from "@data/matchups/mirror.astro";
import StasisProse from "@data/matchups/stasis.astro";
import DevourerProse from "@data/matchups/devourer.astro";
import AggroArmageddonProse from "@data/matchups/aggro_with_armageddon.astro";

const proseComponents: Record<string, any> = {
    enchantress: EnchantressProse,
    elves: ElvesProse,
    rock_and_midrange: RockProse,
    sligh: SlighProse,
    landstill: LandstillProse,
    psychatog: PsychatogProse,
    bw_control: BWControlProse,
    rg_ponza: RGPonzaProse,
    moneyball: MoneyballProse,
    goblins: GoblinsProse,
    terrageddon: TerrageddonProse,
    stiflenought: StiflenoughtProse,
    mirror: MirrorProse,
    stasis: StasisProse,
    devourer: DevourerProse,
    aggro_with_armageddon: AggroArmageddonProse,
};
---

<Layout
    title="Matchups - Replenish Guide | Premodern MTG"
    description="Detailed matchup analysis for Replenish in Premodern. Learn how to beat The Rock, Sligh, Goblins, Burn, and other tier 1 strategies."
>
    <PageHeader
        title="Matchup Analysis"
        description="Detailed matchup breakdowns for Premodern Replenish—how to pick your role, sideboard correctly, and beat the tier 1 and competitive decks."
        isCard={true}
    />
    <div
        class="matchups-container"
        style="margin-top: 1.5rem; margin-bottom: 3rem;"
    >
        <MatchupFilter />

        <div
            class="matchups-list"
            style="display: flex; flex-direction: column; gap: 2rem;"
        >
            {matchups.map((m, i) => {
                const ProseComponent = proseComponents[m.id];
                return (
                    <MatchupCard
                        matchup={m.id}
                        category={m.category}
                        title={m.title}
                        badgeTheme={CATEGORY_BADGE[m.category].theme}
                        badgeText={CATEGORY_BADGE[m.category].text}
                        subtitle={m.subtitle}
                        isOpen={i === 0}
                    >
                        <CardGrid cards={m.cards} />
                        <ProseComponent />
                    </MatchupCard>
                );
            })}
        </div>
    </div>
</Layout>
