---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Card, Badge } from "webcoreui/astro";

---

<Layout
    title="Project Roadmap - Replenish Guide"
    image="/src/assets/banners/tomb.webp"
    description="See what's coming next for the Replenish guide and how you can help out. This is a community-driven project for Premodern Magic."
>
    <PageHeader
        title="Project & Roadmap"
        description="This guide is an open-source, community-driven project. Check out what we're planning to build next, and learn how you can contribute."
        imageSrc="/src/assets/banners/tomb.webp"
        imageAlt="Ancient Tomb"
        imageCaption="Ancient Tomb by Colin MacNeil"
        isCard={true}
    />





    <Card title="Project Backlog & Roadmap" titleTag="h2">
        <p class="text-body">
            Here's what we are currently working on or planning to add to the site in the near future. If you want to tackle any of these, let us know!
        </p>
        <ul style="padding-left: 0; list-style: none; margin-bottom: 0; display: flex; flex-direction: column; gap: 1rem;">
            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>To Do</Badge>
                </div>
                <div>
                    <strong class="text-highlight">Old Border Images:</strong>
                    Replace all card tooltips and banners to ensure every single card uses its classic Premodern old border artwork.
                </div>
            </li>
            
            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>To Do</Badge>
                </div>
                <div>
                    <strong class="text-highlight">Spicy & Bizarre Decklists:</strong>
                    Add a new section dedicated strictly to experimental variations, strange brews, and off-meta lists that run wild ideas.
                </div>
            </li>
            
            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>To Do</Badge>
                </div>
                <div>
                    <strong class="text-highlight">SEO Revision:</strong>
                    Optimize metadata, tags, and structure so the guide is easier to find for players searching for Premodern content.
                </div>
            </li>
            
            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>To Do</Badge>
                </div>
                <div>
                    <strong class="text-highlight">More Resources:</strong>
                    Expand the resources section with more articles, videos, and external links related to the archetype.
                </div>
            </li>

            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>In Planning</Badge>
                </div>
                <div>
                    <strong class="text-highlight">Mulligan Simulator:</strong>
                    An in-browser mini app to generate random opening hands so you can practice your keep/mulligan decisions against specific matchups.
                </div>
            </li>
            
            <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="flex-shrink: 0; margin-top: 0.15rem;">
                    <Badge theme="secondary" small={true}>Open for Contribution</Badge>
                </div>
                <div>
                    <strong class="text-highlight">Tournament Cheat Sheet:</strong>
                    A condensed, printable one-pager summarizing the most important sideboard In/Out plans and Intuition piles to take to your next event.
                </div>
            </li>
        </ul>
    </Card>

    <Card title="Get in Touch" titleTag="h2">
        <p style="margin-top: 0; margin-bottom: 0; line-height: 1.6;">
            Got a feature request, noticed a weird interaction we missed, or want to contribute to the guide? 
            Feel free to reach out directly to <strong style="color: var(--w-color-primary);">@piposperanza</strong> on Discord 
            or open an issue on <a href="https://github.com/ernestosperanza/replenish-guide/issues" target="_blank" rel="noopener noreferrer" style="color: var(--w-color-primary); font-weight: 600; text-decoration: none;">our GitHub repository</a>.
        </p>
    </Card>
</Layout>
