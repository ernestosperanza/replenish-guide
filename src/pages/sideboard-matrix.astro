---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import SideboardMatrix from "@components/SideboardMatrix.astro";
import { Card } from "webcoreui/astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
---

<Layout
    title="Sideboard Matrix - Replenish Guide"
    prev={{ name: "Matchup Analysis", href: "/matchups" }}
    next={{ name: "Resources & Conclusion", href: "/conclusion" }}
>
    <PageHeader title="Sideboard Matrix" />

    <Card title="Lobstercon 2026 Sideboard Matrix" titleTag="h2">
    <p>A quick-reference guide based on the Lobstercon 2026 sideboard strategies:</p>

    <SideboardMatrix />
    </Card>

    <DecklistTooltip />
</Layout>
