---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import SideboardMatrix from "@components/SideboardMatrix.astro";
import { Card } from "webcoreui/astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
---

<Layout title="Sideboard Matrix - Replenish Guide"
    description="The ultimate sideboard guide for Replenish. A comprehensive matrix detailing exactly which cards to bring in and take out against the top Premodern meta decks.">
    <PageHeader title="Sideboard Matrix" />

    <Card title="Lobstercon 2026 Sideboard Matrix" titleTag="h2">
        <p>
            A quick-reference guide based on the Lobstercon 2026 sideboard
            strategies:
        </p>

        <SideboardMatrix />
    </Card>

    <DecklistTooltip />
</Layout>
