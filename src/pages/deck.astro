---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Grid, Card, Badge } from "webcoreui/astro";
import DeckSection from "@components/DeckSection.astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
import CopyDeckButton from "@components/CopyDeckButton.astro";
import { modernDecklists, getCopyString } from "@data/decklists";
---

<Layout
    title="Tournament Lists - Replenish Guide"
    description="Browse the most successful and innovative Replenish decklists in MTG Premodern. Easily copy configurations directly to MTGO, from stock builds to experimental control shells."
>
    <PageHeader
        title="Tournament Lists"
        description="Explore competitive championship configurations of Parallax Replenish—from standard tournament frameworks to innovative creatureless architectures."
        imageSrc="/src/assets/banners/opalescence.jpeg"
        imageAlt="Opalescence"
        imageCaption="Opalescence by John Avon"
        isCard={true}
    />

    <Card title="Architectural Philosophies" titleTag="h2">
        <p style="margin-top: 0; margin-bottom: 0.75rem;">
            While every successful Replenish list relies on an invariant engine
            core, competitive pilots adopt markedly different high-level
            philosophies when tailoring their 75 for regional championship
            metas:
        </p>
        <ul style="padding-left: 1.25rem; margin-bottom: 0;">
            <li style="margin-bottom: 0.5rem;">
                <strong>Game 1 Interference vs. Blanking Removal:</strong> Bryan Gulotta’s
                NA Championship build positions four copies of <a
                    href="#"
                    class="card-hover"
                    data-card-name="Meddling Mage">Meddling Mage</a
                > directly in the maindeck—securing immediate proactive interference
                against combo and permission-heavy control. In contrast, classical
                frameworks like Brian Siu’s and Alessandro Galli’s retain zero creatures
                in the maindeck, systematically blanking the opponent's Game 1 spot
                removal.
            </li>
            <li style="margin-bottom: 0;">
                <strong>Transformational vs. Pure Control Sideboards:</strong> While
                traditional configurations pivot aggressively post-board into midrange
                threat structures (<a
                    href="#"
                    class="card-hover"
                    data-card-name="Exalted Angel">Exalted Angel</a
                >), innovative experimental builds like MarineBiomancer’s
                "Creatureless 75" abandon creature transitions entirely. By
                fielding zero creatures across all 75 slots, they permanently
                render opposing spot removal and sideboard creature sweepers
                inert.
            </li>
        </ul>
    </Card>

    <div
        style="display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; margin-bottom: 3rem;"
    >
        {
            modernDecklists.map((deck) => (
                <Card style="border: 1px solid var(--w-color-primary-80); border-radius: var(--w-lg-radius);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <h2 style="margin: 0; font-size: 1.5rem;">
                            {deck.player}
                        </h2>
                        <CopyDeckButton decklist={getCopyString(deck)} />
                    </div>
                    {deck.badgeText && (
                        <div style="margin-bottom: 1.5rem;">
                            <Badge theme="secondary" small={true}>
                                {deck.badgeText}
                            </Badge>
                        </div>
                    )}
                    {deck.description && (
                        <p
                            style="margin-bottom: 2rem; padding: 1rem; background-color: var(--w-color-primary-95); border-radius: var(--w-lg-radius); border-left: 4px solid var(--w-color-primary);"
                            set:html={deck.description}
                        />
                    )}

                    <div
                        style="border: 1px solid var(--w-color-primary-80); border-radius: var(--w-lg-radius); padding: 1.75rem; background-color: var(--w-color-bg); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);"
                    >
                        <Grid column={3} gap="lg">
                            {deck.columns.map((col) => (
                                <div>
                                    {col.sections.map((sec) => (
                                        <DeckSection
                                            title={sec.title}
                                            items={sec.items}
                                        />
                                    ))}
                                </div>
                            ))}
                        </Grid>
                    </div>
                </Card>
            ))
        }
    </div>
    <DecklistTooltip />
</Layout>
