---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Grid, Card, Badge } from "webcoreui/astro";
import DeckSection from "@components/DeckSection.astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
import CopyDeckButton from "@components/CopyDeckButton.astro";
import { modernDecklists, getCopyString } from "@data/decklists";
---

<Layout
    title="Tournament Lists - Replenish Guide"
    description="Browse the most successful and innovative Replenish decklists in MTG Premodern. Easily copy configurations directly to MTGO, from stock builds to experimental control shells."
>
    <PageHeader
        title="Tournament Lists"
        description="Explore competitive championship configurations of Parallax Replenish—from standard tournament frameworks to innovative creatureless architectures."
        imageSrc="/src/assets/banners/decree.jpeg"
        imageAlt="Decree of Silence"
        imageCaption="Decree of Silence by Adam Rex"
        isCard={true}
    />

    <Card title="Architectural Philosophies" titleTag="h2">
        <p style="margin-top: 0; margin-bottom: 0.75rem;">
            While every successful Replenish list relies on an invariant engine core, competitive builds exhibit markedly different high-level architectural philosophies across tournament metagames:
        </p>
        <ul style="padding-left: 1.25rem; margin-bottom: 0;">
            <li style="margin-bottom: 0.75rem;">
                <strong>Proactive vs. Reactive Maindecks:</strong> Certain proactive frameworks field four copies of <a
                    href="#"
                    class="card-hover"
                    data-card-name="Meddling Mage">Meddling Mage</a
                > directly in Game 1 to secure immediate interference against combo and permission-heavy control. This configuration is particularly formidable in open-decklist tournament environments, where full visibility allows pilots to cripple key opposing win-conditions and disruption engines right from turn two. Conversely, classic reactive configurations retain zero maindeck creatures—systematically turning all opposing spot removal into dead draws in the first game.
            </li>
            <li style="margin-bottom: 0;">
                <strong>Transformational vs. Creatureless Sideboards:</strong> While standard tournament configurations pivot post-board into high-impact aerial threats like <a
                    href="#"
                    class="card-hover"
                    data-card-name="Exalted Angel">Exalted Angel</a
                > (see our <a
                    href="/strategy"
                    class="guide-link"
                    >Macro Strategy</a
                > breakdown), strict creatureless architectures abandon creature transitions entirely to permanently render opposing removal suites inert across all 75 slots.
            </li>
        </ul>
    </Card>

    <div
        style="display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; margin-bottom: 3rem;"
    >
        {
            modernDecklists.map((deck) => (
                <Card style="border: 1px solid var(--w-color-primary-80); border-radius: var(--w-lg-radius);">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <h2 style="margin: 0; font-size: 1.5rem;">
                            {deck.player}
                        </h2>
                        <CopyDeckButton decklist={getCopyString(deck)} />
                    </div>
                    {deck.badgeText && (
                        <div style="margin-bottom: 1.5rem;">
                            <Badge theme="secondary" small={true}>
                                {deck.badgeText}
                            </Badge>
                        </div>
                    )}
                    {deck.description && (
                        <p
                            style="margin-bottom: 2rem; padding: 1rem; background-color: var(--w-color-primary-95); border-radius: var(--w-lg-radius); border-left: 4px solid var(--w-color-primary);"
                            set:html={deck.description}
                        />
                    )}

                    <div style="border: 1px solid var(--w-color-primary-80); border-radius: var(--w-lg-radius); padding: 1.75rem; background-color: var(--w-color-bg); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);">
                        <Grid column={3} gap="lg">
                            {deck.columns.map((col) => (
                                <div>
                                    {col.sections.map((sec) => (
                                        <DeckSection
                                            title={sec.title}
                                            items={sec.items}
                                        />
                                    ))}
                                </div>
                            ))}
                        </Grid>
                    </div>
                </Card>
            ))
        }
    </div>
    <DecklistTooltip />
</Layout>
