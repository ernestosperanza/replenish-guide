---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Grid, Card, Badge } from "webcoreui/astro";
import DeckSection from "@components/DeckSection.astro";
import CopyDeckButton from "@components/CopyDeckButton.astro";
import { modernDecklists, getCopyString } from "@data/decklists";
---

<Layout
    title="Tournament Lists - Replenish Guide | Premodern MTG"
    image="/src/assets/banners/decree.jpeg"
    description="Browse the most successful and innovative Replenish decklists in MTG Premodern. Easily copy configurations directly to MTGO, from stock builds to experimental control shells."
>
    <PageHeader
        title="Tournament Lists"
        description="Competitive, championship-winning Replenish lists—from standard tournament builds to creatureless brews."
        imageSrc="/src/assets/banners/decree.jpeg"
        imageAlt="Decree of Silence"
        imageCaption="Decree of Silence by Adam Rex"
        isCard={true}
    />

    <Card title="How the Builds Differ" titleTag="h2">
        <p style="margin-top: 0; margin-bottom: 0.75rem;">
            Every Replenish list runs the same engine core, but competitive builds take very different approaches around it depending on the metagame:
        </p>
        <ul class="pl-md mb-0">
            <li style="margin-bottom: 0.75rem;">
                <strong>Proactive vs. Reactive Maindecks:</strong> Some proactive builds run four <a
                    role="button" tabindex="0"
                    class="card-hover"
                    data-card-name="Meddling Mage">Meddling Mage</a
                > in Game 1 to get in the way of combo and permission-heavy control right away. That's especially strong in open-decklist events, where seeing your opponent's list lets you name their key win-conditions and disruption from turn two. Classic reactive builds go the other way with zero maindeck creatures, turning all of the opponent's spot removal into dead cards in Game 1.
            </li>
            <li class="mb-0">
                <strong>Transformational vs. Creatureless Sideboards:</strong> Standard builds pivot after boarding into big fliers like <a
                    role="button" tabindex="0"
                    class="card-hover"
                    data-card-name="Exalted Angel">Exalted Angel</a
                > (see our <a
                    href="/strategy"
                    class="guide-link"
                    >Macro Strategy</a
                > breakdown), while strict creatureless builds skip the creature plan entirely so the opponent's removal stays dead across all 75.
            </li>
        </ul>
    </Card>



    <div
        style="display: flex; flex-direction: column; gap: 3rem; margin-bottom: 3rem;"
    >
        {
            modernDecklists.map((deck, index) => (
                <details 
                    class="deck-block group" 
                    open={index === 0 ? true : undefined}
                    style="border: 1px solid var(--w-color-primary-80); border-radius: var(--w-lg-radius); background-color: var(--w-color-primary-95); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15); transition: border-color 0.2s ease; overflow: hidden;"
                >
                    <summary style="cursor: pointer; list-style: none;">
                        <div class="summary-content" style="padding: 2rem; position: relative; display: block;">
                            <h2 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 1.6rem; color: var(--w-color-primary-10); display: flex; justify-content: space-between; align-items: center;">
                                <span>{deck.player}</span>
                                <div style="display: flex; align-items: center; gap: 1rem;">
                                    <div style="font-size: 1rem; color: initial; font-weight: normal;" onclick="event.stopPropagation();">
                                        <CopyDeckButton decklist={getCopyString(deck)} />
                                    </div>
                                    <span class="chevron" style="transition: transform 0.2s; font-size: 1.2rem; color: var(--w-color-primary-60);">▼</span>
                                </div>
                            </h2>
                            {deck.badgeText && (
                                <div style="margin-bottom: 0; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                                    <Badge theme="secondary" small={true}>{deck.badgeText}</Badge>
                                </div>
                            )}
                        </div>
                    </summary>
                    <div class="deck-content" style="padding: 0 2rem 2rem 2rem;">
                        {deck.description && (
                            <p
                                style="margin-bottom: 2rem; padding: 1rem; background-color: var(--w-color-primary-95); border-radius: var(--w-lg-radius); border-left: 4px solid var(--w-color-primary);"
                                set:html={deck.description}
                            />
                        )}

                        <div style="padding-top: 1rem;">
                            <Grid column={3} gap="lg">
                                {deck.columns.map((col) => (
                                    <div>
                                        {col.sections.map((sec) => (
                                            <DeckSection
                                                title={sec.title}
                                                items={sec.items}
                                            />
                                        ))}
                                    </div>
                                ))}
                            </Grid>
                        </div>
                    </div>
                </details>
            ))
        }
    </div>

    <style>
        details > summary::-webkit-details-marker {
            display: none;
        }
        
        details.deck-block .chevron {
            transform: rotate(-90deg);
        }
        
        details.deck-block[open] .chevron {
            transform: rotate(0deg);
        }
        
        details.deck-block[open] .summary-content {
            border-bottom: 1px solid var(--w-color-primary-80);
            margin-bottom: 2rem;
        }
    </style>
</Layout>
