---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Grid, Card, Badge } from "webcoreui/astro";
import DeckSection from "@components/DeckSection.astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
import CopyDeckButton from "@components/CopyDeckButton.astro";
import { modernDecklists, getCopyString } from "@data/decklists";
---

<Layout
    title="Lists - Replenish Guide"
    description="Browse the most successful and innovative Replenish decklists in MTG Premodern. Easily copy configurations directly to MTGO, from stock builds to experimental control shells."
>
    <PageHeader
        title="Lists"
        description="Below are four competitive configurations of Parallax Replenish, spanning standard championship builds to analytical control variants."
        imageSrc="/src/assets/banners/attunement.jpeg"
        imageAlt="Attunement"
        imageCaption="Attunement by Randy Gallegos"
        isCard={true}
    />

    <Card title="Key Differences" titleTag="h2">
        <ul style="padding-left: 1.25rem; margin-bottom: 0;">
            <li style="margin-bottom: 0.5rem;">
                <strong>Decree of Silence (3 vs. 2):</strong> Running a third copy
                is tactically advantageous in slower, attrition-based matchups where
                resolving Replenish is probable, but a basic Opal-Wave loop does not
                guarantee an immediate win. Archetypes such as the mirror, Enchantress,
                BW Control, and shells fielding Tranquil Domain demand this higher
                threat density. Conversely, drop to two copies when facing aggressive
                pressure or heavy countermagic where Replenish is heavily contested
                and resolving an Opal-Wave loop is sufficient to seal the game. In
                those reactive dynamics, minimizing high-cost cards in hand is imperative—particularly
                since velocity discard engines like Frantic Search are trimmed post-sideboard.
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Seal of Cleansing (4 vs. 3 in the 75):</strong> Fielding four
                total copies across the 75 is a potent meta-targeted adaptation that
                escalates in value against Aluren, the Replenish mirror, Enchantress,
                and artifact-heavy control builds. Allocating three copies across
                the 75 represents the leaner, more streamlined option when facing
                fields with fewer relevant targets.
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Tsabo’s Web (3 vs. 2):</strong> Certain configurations dedicate
                three copies across the 75 to counter regional metagames saturated
                with Terrageddon, Dust Bowl, and Rishadan Port. In broader online
                ecosystems where land-destruction archetypes have declined, restricting
                this allocation to two total copies is the current competitive standard.
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Maindeck vs. Sideboard Creatures:</strong> Bryan Gulotta’s
                championship configuration positions 4 Meddling Mages directly in
                the maindeck—securing immediate, game-one interference against fast
                combo and permission-dense control decks. In contrast, standard frameworks
                like Alessandro Galli’s retain creatures strictly in the sideboard,
                intentionally insulating the combo engine by blanking the opponent's
                spot removal during Game 1.
            </li>
        </ul>
    </Card>

    <div
        style="display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; margin-bottom: 3rem;"
    >
        {
            modernDecklists.map((deck) => (
                <Card>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <h2 style="margin: 0; font-size: 1.5rem;">
                            {deck.player}
                        </h2>
                        <CopyDeckButton decklist={getCopyString(deck)} />
                    </div>
                    {deck.badgeText && (
                        <div style="margin-bottom: 1.5rem;">
                            <Badge
                                theme={deck.badgeTheme || "info"}
                                small={true}
                            >
                                {deck.badgeText}
                            </Badge>
                        </div>
                    )}
                    {deck.description && (
                        <p
                            style="margin-bottom: 2rem; padding: 1rem; background-color: var(--w-color-primary-95); border-radius: var(--w-lg-radius); border-left: 4px solid var(--w-color-primary);"
                            set:html={deck.description}
                        />
                    )}

                    <Grid column={3} gap="lg">
                        {deck.columns.map((col) => (
                            <div>
                                {col.sections.map((sec) => (
                                    <DeckSection
                                        title={sec.title}
                                        items={sec.items}
                                    />
                                ))}
                            </div>
                        ))}
                    </Grid>
                </Card>
            ))
        }
    </div>
    <DecklistTooltip />
</Layout>
