---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Grid, Card, Badge } from "webcoreui/astro";
import DeckSection from "@components/DeckSection.astro";
import DecklistTooltip from "@components/DecklistTooltip.astro";
import CopyDeckButton from "@components/CopyDeckButton.astro";
import { modernDecklists, getCopyString } from "@data/decklists";
---

<Layout
    title="Lists - Replenish Guide"
    description="Browse the most successful and innovative Replenish decklists in MTG Premodern. Easily copy configurations directly to MTGO, from stock builds to experimental control shells."
>
    <PageHeader
        title="Lists"
        description="Below are four different configurations of Parallax Replenish, ranging from stock modern builds to classic lists and experimental control variants."
        imageSrc="/src/assets/banners/attunement.jpeg"
        imageAlt="Attunement"
        imageCaption="Attunement by Randy Gallegos"
        isCard={true}
    />

    <Card title="Key Differences" titleTag="h2">
        <ul style="padding-left: 1.25rem; margin-bottom: 0;">
            <li style="margin-bottom: 0.5rem;">
                <strong>Decree of Silence (3 vs. 2):</strong> Three is relevant in
                situations where Replenish is likely to resolve and Opal+Wave does
                not necessarily mean an immediate win. Matchups like Sligh, the mirror,
                Enchantress, BW Control, and decks with Tranquil Domain fall into
                this category. You go down to two when the opposite is true: when
                Replenish is hard to resolve, or when resolving an Opal+Wave is enough
                to win the game by itself. In those situations, having fewer Decrees
                clogging up your hand is much better (especially since against control
                you side out discard outlets like Frantic Search anyway).
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Seal of Cleansing (4 vs. 3 in the 75):</strong> Running four
                total is a luxury. It's gotten better with the rise of Aluren, the
                Replenish mirror, Enchantress, and other enchantment-heavy decks.
                Three in the 75 is the leaner option if those matchups are less common
                in your field.
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Tsabo’s Web (3 vs. 2):</strong> Some lists run three because
                their local region has a lot of Terrageddon and Port. Online, Terrageddon
                has been trending down, so the count is closer to two in the 75 for
                most general builds.
            </li>
            <li style="margin-bottom: 0.5rem;">
                <strong>Maindeck vs Sideboard Creatures:</strong> Bryan Gulotta's
                list puts 4 Meddling Mages in the maindeck for proactive protection
                against fast combo and control, while lists like Alessandro's keep
                them in the sideboard to blank opposing removal Game 1.
            </li>
        </ul>
    </Card>

    <div
        style="display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; margin-bottom: 3rem;"
    >
        {
            modernDecklists.map((deck) => (
                <Card>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                        <h2 style="margin: 0; font-size: 1.5rem;">
                            {deck.player}
                        </h2>
                        <CopyDeckButton decklist={getCopyString(deck)} />
                    </div>
                    {deck.badgeText && (
                        <div style="margin-bottom: 1.5rem;">
                            <Badge theme={deck.badgeTheme || "info"} small={true}>
                                {deck.badgeText}
                            </Badge>
                        </div>
                    )}
                    {deck.description && (
                        <p
                            style="margin-bottom: 2rem; padding: 1rem; background-color: var(--w-color-primary-95); border-radius: var(--w-lg-radius); border-left: 4px solid var(--w-color-primary);"
                            set:html={deck.description}
                        />
                    )}

                    <Grid column={3} gap="lg">
                        {deck.columns.map((col) => (
                            <div>
                                {col.sections.map((sec) => (
                                    <DeckSection
                                        title={sec.title}
                                        items={sec.items}
                                    />
                                ))}
                            </div>
                        ))}
                    </Grid>
                </Card>
            ))
        }
    </div>
    <DecklistTooltip />
</Layout>
