---
import Layout from "@components/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { Card } from "webcoreui/astro";
---

<Layout
    title="Intuition Cheatsheet - Replenish Guide | Premodern MTG"
    image="/src/assets/banners/intuition.jpeg"
    description="Master the art of Intuition in Replenish. Discover common pile patterns, engine setups, and complex situational plays to maximize your card selection."
>
    <PageHeader
        title="The Intuition Cheatsheet"
        description="<strong>A few tips:</strong> Intuition takes real skill, and it'll take a while to learn every line it opens up, since it does so many jobs over the course of a game. The core tradeoff is now versus later: when you tutor for a non-combo piece (like removal or a sideboard card), you're pulling three copies out of your deck to guarantee one in hand right now. Keep this in mind when building your deck, too—anything you want to reliably fetch with Intuition needs at least 3 copies in your 75."
        imageSrc="/src/assets/banners/intuition.jpeg"
        imageAlt="Intuition"
        imageCaption="Intuition by April Lee"
        isCard={true}
    />

    <!-- ═══════════════════════════════════════════════
         SECTION 1: Core Mechanics — Compact Info Box
         ═══════════════════════════════════════════════ -->
    <Card title="How Piles Work" titleTag="h2">
        <p>
            Your opponent picks which card goes to your hand—the other two hit
            the graveyard. Build every pile around this rule:
        </p>
        <div class="enforce-rules">
            <div class="enforce-rule">
                <span class="enforce-number enforce-number--hand">3</span>
                <span>copies → guarantees one <strong>in hand</strong>. Use when you need a specific answer right now.</span>
            </div>
            <div class="enforce-rule">
                <span class="enforce-number enforce-number--yard">2</span>
                <span>copies → guarantees one <strong>in the graveyard</strong>. Use when you're setting up a <a role="button" tabindex="0" class="card-hover" data-card-name="Replenish">Replenish</a>.</span>
            </div>
        </div>
    </Card>

    <!-- ═══════════════════════════════════════════════
         SECTION 2: General Heuristics & Timing
         ═══════════════════════════════════════════════ -->
    <Card title="General Heuristics & Timing" titleTag="h2">
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div>
                <strong class="card-heading">Post-Sideboard Role Shift & On-Stack Hate</strong>
                <p class="mb-0">
                    Against permanent graveyard hate like <a role="button" tabindex="0" class="card-hover" data-card-name="Tormod's Crypt">Tormod's Crypt</a>,
                    <a role="button" tabindex="0" class="card-hover" data-card-name="Phyrexian Furnace">Phyrexian Furnace</a>,
                    or <a role="button" tabindex="0" class="card-hover" data-card-name="Planar Void">Planar Void</a>,
                    don't build combo-dumping piles blind. Intuition becomes a
                    removal tutor—grab three <a role="button" tabindex="0" class="card-hover" data-card-name="Seal of Cleansing">Seal of Cleansing</a>
                    or <a role="button" tabindex="0" class="card-hover" data-card-name="Disenchant">Disenchant</a>
                    to clear their hate before reassembling the combo.
                </p>
            </div>
            <div>
                <strong class="card-heading">Deck Depletion & Threat Density</strong>
                <p class="mb-0">
                    In long games against control, don't over-tutor. Intuition
                    pulls three cards at a time, and with <a role="button" tabindex="0" class="card-hover" data-card-name="Attunement">Attunement</a>
                    and <a role="button" tabindex="0" class="card-hover" data-card-name="Frantic Search">Frantic Search</a>
                    looting on top, you can burn through win conditions or risk
                    decking out if your first reanimation attempts get countered.
                    Know when to stop thinning and start conserving.
                </p>
            </div>
        </div>
    </Card>

    <!-- ═══════════════════════════════════════════════
         SECTION 3: Common Tactical Piles — Reference Table
         ═══════════════════════════════════════════════ -->
    <Card title="Common Tactical Piles" titleTag="h2">
        <p style="margin-bottom: 1.25rem;">
            The standard piles and when to reach for each one. <span class="badge-legend"><span class="enforce-dot enforce-dot--hand"></span> = to hand</span> <span class="badge-legend"><span class="enforce-dot enforce-dot--yard"></span> = to graveyard</span>
        </p>

        <table class="ref-table">
            <thead>
                <tr>
                    <th>Pile</th>
                    <th>When to Use</th>
                    <th>Standard Configurations</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td data-label="Pile"><strong>Dumping Combo Pieces</strong></td>
                    <td data-label="When to Use">
                        You're holding <a role="button" tabindex="0" class="card-hover" data-card-name="Replenish">Replenish</a>
                        plus a discard outlet. Need enchantments in the yard now.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Opalescence">Opal</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Decree of Silence">Decree</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Parallax Wave">Wave</a></span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Opalescence">Opal</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Opalescence">Opal</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Parallax Wave">Wave</a></span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Parallax Wave">Wave</a> ×3</span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--amber">Graveyard</span></td>
                </tr>
                <tr>
                    <td data-label="Pile"><strong>Split Piles</strong></td>
                    <td data-label="When to Use">
                        Late game. Three different cards that all advance your plan—every
                        choice the opponent makes is wrong.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Replenish">Replenish</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Attunement">Attunement</a> + <a role="button" tabindex="0" class="card-hover" data-card-name="Parallax Wave">Wave</a></span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--blue">Hand</span></td>
                </tr>
                <tr>
                    <td data-label="Pile"><strong>Targeted Removal</strong></td>
                    <td data-label="When to Use">
                        A creature clock or a lock piece is about to kill you.
                        Grab whichever answer the board needs.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Swords to Plowshares">Swords</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Seal of Cleansing">Seal</a> ×3</span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--blue">Hand</span></td>
                </tr>
                <tr>
                    <td data-label="Pile"><strong>Land Drops</strong></td>
                    <td data-label="When to Use">
                        Mana-light hand that's otherwise great, or late-game deck
                        thinning against control.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Ancient Tomb">Tomb</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Skycloud Expanse">Skycloud</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Plains">Plains</a> ×3</span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--blue">Hand</span></td>
                </tr>
                <tr>
                    <td data-label="Pile"><strong>Discard Engine</strong></td>
                    <td data-label="When to Use">
                        Hand is clogged with enchantments and <a role="button" tabindex="0" class="card-hover" data-card-name="Replenish">Replenish</a>
                        but no way to discard them.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Frantic Search">Frantic Search</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Attunement">Attunement</a> ×3</span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--blue">Hand</span></td>
                </tr>
                <tr>
                    <td data-label="Pile"><strong>Sideboard Tech</strong></td>
                    <td data-label="When to Use">
                        Games 2–3. Shut off counters, disable utility lands, or
                        stop their combo cold.
                    </td>
                    <td data-label="Configs">
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Meddling Mage">Meddling Mage</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Abeyance">Abeyance</a> ×3</span>
                        <span class="ref-config"><a role="button" tabindex="0" class="card-hover" data-card-name="Tsabo's Web">Tsabo's Web</a> ×3</span>
                    </td>
                    <td data-label="Type"><span class="ref-badge ref-badge--blue">Hand</span></td>
                </tr>
            </tbody>
        </table>
    </Card>
</Layout>

<style>
    /* ──────────────────────────────────────────────
       Enforce Rules (Section 1 — compact info box)
       ────────────────────────────────────────────── */
    .enforce-rules {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .enforce-rule {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        color: var(--w-color-primary-20);
        line-height: 1.5;
    }

    .enforce-number {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        width: 1.75rem;
        text-align: center;
    }

    .enforce-number--hand {
        color: #5a9fd4;
    }

    .enforce-number--yard {
        color: #d4a44a;
    }

    /* ──────────────────────────────────────────────
       Pile Table (Section 3)
       ────────────────────────────────────────────── */
    .badge-legend {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--w-color-primary-30);
        margin-right: 0.75rem;
    }

    .enforce-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .enforce-dot--hand {
        background: #5a9fd4;
    }

    .enforce-dot--yard {
        background: #d4a44a;
    }

</style>
