---
import { Flex } from "webcoreui/astro";
export interface Props {
    title: string;
    image: string;
}
const { title, image } = Astro.props;
---
<Flex gap="lg" alignment={{ vertical: "start" }} wrap="wrap" style="margin-bottom: 2.5rem;">
    <img src={`/images/cards/${image}`} alt={title} style="width: 220px; border-radius: 4.75% / 3.5%; flex-shrink: 0; border: 1px solid var(--w-color-primary-50);" />
    <div style="flex: 1; min-width: 250px;">
        <h3 style="margin-top: 0; margin-bottom: 0.75rem;">{title}</h3>
        <slot />
    </div>
</Flex>
