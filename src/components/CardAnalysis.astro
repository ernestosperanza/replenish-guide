---
import { Flex, Badge } from "webcoreui/astro";
import { Image } from "astro:assets";

export interface Props {
    title: string;
    image?: string;
    collapsible?: boolean;
    badge?: string;
}
const { title, image, collapsible = false, badge } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/cards/**/*.{jpeg,jpg,png,gif,webp}",
);
const fullPath = image ? `/src/assets/cards/${image}` : "";

let importedImage: ImageMetadata | null = null;
if (image && images[fullPath]) {
    importedImage = (await images[fullPath]()).default;
}
---

<div class="card-analysis-wrapper">
    {
        collapsible ? (
            <details class="card-details">
                <summary class="card-summary">
                    <span class="card-title">{title}</span>
                    {badge && <Badge theme="secondary" small={true}>{badge}</Badge>}
                </summary>
                <div class="collapsible-content">
                    <Flex gap="lg" alignment={{ vertical: "start" }} wrap="wrap">
                        {image && (
                            <div class="card-image-container">
                                {importedImage ? (
                                    <Image
                                        src={importedImage}
                                        alt={title}
                                        width={400}
                                        class="card-image"
                                    />
                                ) : (
                                    <img
                                        src={fullPath}
                                        alt={title}
                                        class="card-image"
                                    />
                                )}
                            </div>
                        )}
                        <div class="card-text-content">
                            <slot />
                        </div>
                    </Flex>
                </div>
            </details>
        ) : (
            <div class="card-analysis-box">
                <Flex
                    gap="lg"
                    alignment={{ vertical: "start" }}
                    wrap="wrap"
                >
                    {image && (
                        <div class="card-image-container">
                            {importedImage ? (
                                <Image
                                    src={importedImage}
                                    alt={title}
                                    width={400}
                                    class="card-image"
                                />
                            ) : (
                                <img
                                    src={fullPath}
                                    alt={title}
                                    class="card-image"
                                />
                            )}
                        </div>
                    )}
                    <div class="card-text-content">
                        <div class="card-header">
                            <h3 class="card-title-main">{title}</h3>
                            {badge && <Badge theme="secondary" small={true}>{badge}</Badge>}
                        </div>
                        <div class="slot-content">
                            <slot />
                        </div>
                    </div>
                </Flex>
            </div>
        )
    }
</div>

<style>
    /* 1. Clean Open Canvas & Vertical Spacing */
    .card-analysis-box {
        margin-bottom: 2.25rem;
    }

    .card-details {
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--w-color-primary-80);
        padding-bottom: 0.75rem;
    }

    /* 2. Tactile Card Image Micro-Animations */
    .card-image-container {
        flex-shrink: 0;
        perspective: 1000px;
    }

    .card-image {
        width: 220px;
        height: auto;
        display: block;
        border-radius: 4.75% / 3.5%;
        border: 2px solid var(--w-color-bg);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
        filter: brightness(0.96) contrast(1.03);
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                    box-shadow 0.4s ease, 
                    filter 0.4s ease;
        will-change: transform;
    }

    .card-image:hover {
        transform: scale(1.045) translateY(-6px) rotate(0.6deg);
        filter: brightness(1.05) contrast(1.05);
        box-shadow: 0 20px 40px -10px rgba(59, 130, 246, 0.35), 
                    0 0 25px rgba(245, 158, 11, 0.2);
        z-index: 10;
        cursor: pointer;
    }

    /* 3. Text Layout & Typography Cleanliness */
    .card-text-content {
        flex: 1;
        min-width: 260px;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
        flex-wrap: wrap;
    }

    .card-title-main {
        margin: 0;
        color: var(--w-color-primary-10);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .slot-content {
        color: var(--w-color-primary-20);
        line-height: 1.65;
    }

    /* Auto-handle paragraph margins so pages don't need inline styles */
    .slot-content p:first-child,
    .collapsible-content p:first-child {
        margin-top: 0;
    }

    .slot-content p:last-child,
    .collapsible-content p:last-child {
        margin-bottom: 0;
    }

    /* 4. Collapsible Elements Polish */
    .card-summary {
        cursor: pointer;
        font-size: 1.25rem;
        font-weight: bold;
        color: var(--w-color-primary-10);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: transform 0.2s ease;
        list-style-type: disclosure-closed;
        padding-bottom: 0.5rem;
    }

    .card-details[open] .card-summary {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 1rem;
        list-style-type: disclosure-open;
    }

    .card-summary:hover {
        transform: translateX(3px);
    }

    .collapsible-content {
        padding-top: 0.5rem;
    }

    /* Responsive scaling for narrower screens */
    @media (max-width: 640px) {
        .card-image {
            width: 180px;
            margin: 0 auto;
        }
    }
</style>
