---
import { Flex, Badge } from "webcoreui/astro";
import { Image } from "astro:assets";

export interface Props {
    title: string;
    image: string;
    collapsible?: boolean;
    badge?: string;
}
const { title, image, collapsible = false, badge } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/cards/**/*.{jpeg,jpg,png,gif,webp}",
);
const fullPath = `/src/assets/cards/${image}`;

let importedImage: ImageMetadata | null = null;
if (images[fullPath]) {
    importedImage = (await images[fullPath]()).default;
}
---

{
    collapsible ? (
        <details style="margin-bottom: 0.5rem; border-bottom: 1px solid var(--w-color-primary-80); padding-bottom: 0.5rem;">
            <summary style="cursor: pointer; font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem; color: var(--w-color-primary-10); padding: 0.5rem; border-radius: var(--w-sm-radius); display: flex; align-items: center; gap: 0.75rem;">
                <span>{title}</span>
                {badge && <Badge theme="secondary" small={true}>{badge}</Badge>}
            </summary>
            <div style="padding-top: 0.5rem;">
                <Flex gap="lg" alignment={{ vertical: "start" }} wrap="wrap">
                    {importedImage ? (
                        <Image
                            src={importedImage}
                            alt={title}
                            width={400}
                            style="width: 220px; height: auto; border-radius: 4.75% / 3.5%; flex-shrink: 0; border: 1px solid var(--w-color-primary-50);"
                        />
                    ) : (
                        <img
                            src={fullPath}
                            alt={title}
                            style="width: 220px; border-radius: 4.75% / 3.5%; flex-shrink: 0; border: 1px solid var(--w-color-primary-50);"
                        />
                    )}
                    <div style="flex: 1; min-width: 250px;">
                        <slot />
                    </div>
                </Flex>
            </div>
        </details>
    ) : (
        <Flex
            gap="lg"
            alignment={{ vertical: "start" }}
            wrap="wrap"
            style="margin-bottom: 0.5rem;"
        >
            {importedImage ? (
                <Image
                    src={importedImage}
                    alt={title}
                    width={400}
                    style="width: 220px; height: auto; border-radius: 4.75% / 3.5%; flex-shrink: 0; border: 1px solid var(--w-color-primary-50);"
                />
            ) : (
                <img
                    src={fullPath}
                    alt={title}
                    style="width: 220px; border-radius: 4.75% / 3.5%; flex-shrink: 0; border: 1px solid var(--w-color-primary-50);"
                />
            )}
            <div style="flex: 1; min-width: 250px;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                    <h3 style="margin: 0;">{title}</h3>
                    {badge && <Badge theme="secondary" small={true}>{badge}</Badge>}
                </div>
                <slot />
            </div>
        </Flex>
    )
}
