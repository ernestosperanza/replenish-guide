---
import Header from "./Header.astro";
import AppSidebar from "./AppSidebar.astro";
import Pagination from "./Pagination.astro";
import Footer from "./Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "Replenish Guide",
    description = "The definitive guide to playing the Replenish deck in the Premodern format.",
    image = "/images/banners/replenish.webp",
} = Astro.props;

// Construimos la URL absoluta de la imagen para el og:image (requerido por Twitter/Facebook)
const siteUrl = Astro.site ? Astro.site.toString() : "https://replenish.guide";
const ogImageUrl = new URL(image, siteUrl).toString();

const schema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: description,
    image: ogImageUrl,
    author: {
        "@type": "Person",
        name: "ernesthope",
    },
    publisher: {
        "@type": "Organization",
        name: "Replenish Guide",
        logo: {
            "@type": "ImageObject",
            url: new URL("/logo.svg", siteUrl).toString(),
        },
    },
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <title>{title}</title>

        <!-- SEO y Metadatos -->
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="MTG, Magic the Gathering, Premodern, Replenish, Combo Deck, Sideboard Guide"
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImageUrl} />
        <meta property="twitter:creator" content="@ernesthope" />

        <!-- Canonical -->
        <link rel="canonical" href={Astro.url} />

        <!-- JSON-LD Schema -->
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </head>
    <body>
        <Header />

        <div class="flex main-wrapper">
            <AppSidebar />

            <main class="content-area">
                <div class="content-container">
                    <slot />
                    <Pagination />
                    <Footer />
                </div>
            </main>
        </div>
        <SpeedInsights />
        <Analytics />
    </body>
</html>

<style lang="scss" is:global>
    @use "webcoreui/styles" as *;

    @include setup(
        (
            fontRegular: "/fonts/Inter-Regular.woff2",
            fontBold: "/fonts/Inter-Bold.woff2",
            theme: "vintage",
        )
    );

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background-color: var(--w-color-primary-70);
        color: var(--w-color-primary);
        font-family: var(--w-font-sans);
    }

    .main-wrapper {
        display: flex;
        min-height: calc(100vh - 60px);
    }

    .content-area {
        flex: 1;
        padding: var(--w-space-md);
        display: flex;
        justify-content: center;
        min-width: 0;
    }

    .content-container {
        width: 100%;
        max-width: 800px;
        min-width: 0;
    }

    // Typography rules para todo el sitio
    h1,
    h2,
    h3,
    h4 {
        margin-top: 0.5em;
        margin-bottom: 0.5em;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 0;
    }

    p {
        line-height: 1.6;
        color: var(--w-color-primary-10);
        margin-bottom: 1.2em;
    }

    /* Reduce el espacio entre todas las secciones (Cards) globalmente */
    :global(.w-card) {
        margin-bottom: 1rem !important;
    }

    @media (max-width: 768px) {
        .content-area {
            padding: var(--w-space-md);
        }

        h1 {
            font-size: 2rem !important;
        }

        h2 {
            font-size: 1.75rem !important;
        }

        h3 {
            font-size: 1.5rem !important;
        }
    }
    // Estilo global para hacer las tarjetas transparentes y sin borde
    [class*="card_"] {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        min-width: 0;
    }

    [class*="card_"] > [class*="body_"] {
        min-width: 0;
    }

    /* Guide Links (internal navigation across all pages) */
    .guide-link {
        color: #8c4b22; /* Vintage rusty brown/copper */
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.15s;
    }

    .guide-link:hover {
        color: #5c3014; /* Darker brown on hover */
    }
</style>
