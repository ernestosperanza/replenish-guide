---
import Header from "./Header.astro";
import AppSidebar from "./AppSidebar.astro";
import Pagination from "./Pagination.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
    title?: string;
    prev?: { name: string; href: string };
    next?: { name: string; href: string };
}

const { title = "Replenish Guide", prev, next } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Guía HFEB" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <title>{title}</title>
    </head>
    <body>
        <Header />

        <div class="flex main-wrapper">
            <AppSidebar />

            <main class="content-area">
                <div class="content-container">
                    <slot />
                    {(prev || next) && <Pagination prev={prev} next={next} />}
                </div>
            </main>
        </div>
        <SpeedInsights />
        <Analytics />
    </body>
</html>

<style lang="scss" is:global>
    @use "webcoreui/styles" as *;

    @include setup(
        (
            fontRegular: "/fonts/Inter-Regular.woff2",
            fontBold: "/fonts/Inter-Bold.woff2",
            theme: "vintage",
        )
    );

    body {
        margin: 0;
        background-color: var(--w-color-primary-70);
        color: var(--w-color-primary);
        font-family: var(--w-font-sans);
    }

    .main-wrapper {
        display: flex;
        min-height: calc(100vh - 60px);
    }

    .content-area {
        flex: 1;
        padding: var(--w-space-xl);
        display: flex;
        justify-content: center;
    }

    .content-container {
        width: 100%;
        max-width: 800px;
    }

    // Typography rules para todo el sitio
    h1,
    h2,
    h3,
    h4 {
        margin-top: 1.5em;
        margin-bottom: 0.5em;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 0;
    }

    p {
        line-height: 1.6;
        color: var(--w-color-primary-10);
        margin-bottom: 1.2em;
    }
</style>
