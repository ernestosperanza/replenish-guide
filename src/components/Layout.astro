---
import Header from "./Header.astro";
import AppSidebar from "./AppSidebar.astro";
import Pagination from "./Pagination.astro";
import Footer from "./Footer.astro";
import DecklistTooltip from "./DecklistTooltip.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { getImage } from "astro:assets";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "Replenish Primer & Guide | Premodern MTG",
    description = "The definitive Replenish primer and strategy guide for the Premodern MTG format. Learn the Replenish combo, matchups, sideboarding, and deck mechanics.",
    image = "/images/banners/replenish.webp",
} = Astro.props;

// Construimos la URL absoluta de la imagen para el og:image (requerido por Twitter/Facebook)
const siteUrl = Astro.site ? Astro.site.toString() : "https://replenish.guide";

// If `image` points at a src/assets banner, generate an optimized 1200px JPEG
// (broad social-crawler compatibility). Otherwise treat it as a public path.
const banners = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/banners/*.{jpg,jpeg,png,webp}",
);
let ogImageUrl: string;
if (image in banners) {
    const meta = (await banners[image]()).default;
    const og = await getImage({ src: meta, width: 1200, format: "jpeg" });
    ogImageUrl = new URL(og.src, siteUrl).toString();
} else {
    ogImageUrl = new URL(image, siteUrl).toString();
}

const schema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: description,
    image: ogImageUrl,
    author: {
        "@type": "Person",
        name: "ernesthope",
    },
    publisher: {
        "@type": "Organization",
        name: "Replenish Guide",
        logo: {
            "@type": "ImageObject",
            url: new URL("/logo.svg", siteUrl).toString(),
        },
    },
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <link
            rel="preload"
            href="/fonts/Inter-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/Inter-Bold.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{title}</title>

        <!-- SEO y Metadatos -->
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="Replenish Primer, Replenish Guide, Premodern MTG, Replenish Premodern, Magic the Gathering, Replenish Combo Deck, MTG Premodern, Replenish Decklist, Sideboard Guide"
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImageUrl} />
        <meta property="twitter:creator" content="@ernesthope" />

        <!-- Canonical -->
        <link rel="canonical" href={Astro.url} />

        <!-- JSON-LD Schema -->
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </head>
    <body>
        <a href="#main-content" class="skip-link">Skip to content</a>
        <Header />

        <div class="flex main-wrapper">
            <AppSidebar />

            <main id="main-content" tabindex="-1" class="content-area">
                <div class="content-container">
                    <slot />
                    <Pagination />
                    <Footer />
                </div>
            </main>
        </div>
        <DecklistTooltip />
        <button
            id="scroll-top"
            class="scroll-top"
            aria-label="Back to top"
            title="Back to top">&uarr;</button>
        <SpeedInsights />
        <Analytics />

        <script is:inline>
            (function () {
                const btn = document.getElementById("scroll-top");
                if (!btn) return;
                const toggle = () =>
                    btn.classList.toggle("visible", window.scrollY > 300);
                window.addEventListener("scroll", toggle, { passive: true });
                toggle();
                btn.addEventListener("click", () =>
                    window.scrollTo({ top: 0, behavior: "smooth" })
                );
            })();
        </script>
    </body>
</html>

<style lang="scss" is:global>
    @use "webcoreui/styles" as *;

    @include setup(
        (
            fontRegular: "/fonts/Inter-Regular.woff2",
            fontBold: "/fonts/Inter-Bold.woff2",
            theme: "vintage",
        )
    );

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background-color: var(--w-color-primary-70);
        color: var(--w-color-primary);
        font-family: var(--w-font-sans);
    }

    .main-wrapper {
        display: flex;
        min-height: calc(100vh - 60px);
    }

    .content-area {
        flex: 1;
        padding: var(--w-space-md);
        display: flex;
        justify-content: center;
        min-width: 0;
    }

    .content-container {
        width: 100%;
        max-width: 800px;
        min-width: 0;
    }

    // Typography rules para todo el sitio
    h1,
    h2,
    h3,
    h4 {
        margin-top: 0.5em;
        margin-bottom: 0.25em;
    }

    /* Collapse top margin of first paragraph after any heading */
    h1 + p,
    h2 + p,
    h3 + p,
    h4 + p {
        margin-top: 0;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 0;
    }

    p {
        line-height: 1.6;
        color: var(--w-color-primary-10);
        margin-top: 0em;
        margin-bottom: 0.5em;
    }

    /* Semantic Utility Classes */
    .m-0 { margin: 0 !important; }
    .mt-0 { margin-top: 0 !important; }
    .mb-0 { margin-bottom: 0 !important; }
    .mb-sm { margin-bottom: 0.5rem !important; }
    .pl-md { padding-left: 1.25rem !important; }
    .text-body {
        color: var(--w-color-primary-20);
        margin-top: 0;
        margin-bottom: 1.25rem;
    }

    .text-highlight {
        color: var(--w-color-primary-10);
    }

    .list-spaced {
        padding-left: 1.25rem;
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-heading {
        margin-bottom: 0.25rem;
        font-size: 1.1rem;
        display: block;
    }

    /* Inline note/callout box */
    .callout {
        background-color: var(--w-color-primary-95);
        padding: 0.75rem 1rem;
        border-radius: var(--w-md-radius);
        font-size: 0.95rem;
        border-left: 3px solid var(--w-color-primary-40);
    }


    /* Reduce el espacio entre todas las secciones (Cards) globalmente */
    :global(.w-card) {
        margin-bottom: 1rem !important;
    }

    @media (max-width: 768px) {
        .content-area {
            padding: var(--w-space-md);
        }

        h1 {
            font-size: 2rem !important;
        }

        h2 {
            font-size: 1.75rem !important;
        }

        h3 {
            font-size: 1.5rem !important;
        }
    }
    // Estilo global para hacer las tarjetas transparentes y sin borde
    [class*="card_"] {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        min-width: 0;
    }

    [class*="card_"] > [class*="body_"] {
        min-width: 0;
        padding-top: 0.25rem !important;
    }

    /* Guide Links (internal navigation across all pages) */
    .guide-link {
        color: #8c4b22; /* Vintage rusty brown/copper */
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.15s;
    }

    .guide-link:hover {
        color: #5c3014; /* Darker brown on hover */
    }

    /* ─── Reusable Reference Table ─── */
    .ref-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
        line-height: 1.5;
    }

    .ref-table thead {
        border-bottom: 2px solid var(--w-color-primary-50);
    }

    .ref-table th {
        text-align: left;
        padding: 0.6rem 0.75rem;
        color: var(--w-color-primary-20);
        font-weight: 600;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .ref-table td {
        padding: 0.75rem;
        color: var(--w-color-primary-20);
        vertical-align: top;
        border-bottom: 1px solid rgba(150, 150, 150, 0.1);
    }

    .ref-table tbody tr:last-child td {
        border-bottom: none;
    }

    .ref-table tbody tr:nth-child(even) {
        background: rgba(150, 150, 150, 0.04);
    }

    .ref-table td:first-child {
        white-space: nowrap;
        color: var(--w-color-primary-10);
    }

    /* Pill badges for table cells */
    .ref-badge {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .ref-badge--blue {
        background: rgba(90, 159, 212, 0.15);
        color: #5a9fd4;
        border: 1px solid rgba(90, 159, 212, 0.3);
    }

    .ref-badge--amber {
        background: rgba(212, 164, 74, 0.15);
        color: #d4a44a;
        border: 1px solid rgba(212, 164, 74, 0.3);
    }

    .ref-badge--green {
        background: rgba(46, 204, 113, 0.12);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.25);
    }

    .ref-badge--red {
        background: rgba(231, 76, 60, 0.12);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.25);
    }

    /* Each config on its own line within a cell */
    .ref-config {
        display: block;
        padding: 0.15rem 0;
    }

    /* Responsive: table → stacked cards on mobile */
    @media (max-width: 640px) {
        .ref-table thead {
            display: none;
        }

        .ref-table,
        .ref-table tbody,
        .ref-table tr,
        .ref-table td {
            display: block;
            width: 100%;
        }

        .ref-table tr {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(150, 150, 150, 0.12);
        }

        .ref-table tbody tr:last-child {
            border-bottom: none;
        }

        .ref-table tbody tr:nth-child(even) {
            background: none;
        }

        .ref-table td {
            padding: 0.2rem 0;
            border-bottom: none;
        }

        .ref-table td:first-child {
            white-space: normal;
            font-size: 1rem;
            padding-bottom: 0.25rem;
        }

        .ref-table td::before {
            content: attr(data-label);
            display: block;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--w-color-primary-30);
            margin-bottom: 0.1rem;
            font-weight: 600;
        }

        .ref-table td:first-child::before,
        .ref-table td:last-child::before {
            display: none;
        }

        .ref-table td:last-child {
            padding-top: 0.35rem;
        }
    }

    /* Floating back-to-top button (long pages) */
    .scroll-top {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 200;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid #111;
        background-color: var(--w-color-primary-60);
        color: var(--w-color-primary-10);
        font-size: 1.25rem;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            background-color 0.2s ease;
    }

    .scroll-top.visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .scroll-top:hover {
        background-color: var(--w-color-primary-50);
    }

    /* Keyboard focus visibility (vintage-themed ring), keyboard-only */
    :where(a, button, summary, [tabindex]):focus-visible {
        outline: 2px solid #8c4b22;
        outline-offset: 2px;
        border-radius: 2px;
    }

    summary:focus:not(:focus-visible) {
        outline: none;
    }

    /* Skip-to-content link: hidden until focused via keyboard */
    .skip-link {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        padding: 0.6rem 1rem;
        background-color: var(--w-color-primary-70);
        color: var(--w-color-primary-10);
        border: 2px solid #8c4b22;
        border-radius: 0 0 var(--w-sm-radius) 0;
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-120%);
        transition: transform 0.15s ease;
    }

    .skip-link:focus {
        transform: translateY(0);
    }

    /* main is a programmatic focus target, not interactive — no focus ring */
    #main-content:focus,
    #main-content:focus-visible {
        outline: none;
    }
</style>
