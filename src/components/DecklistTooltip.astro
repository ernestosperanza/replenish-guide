            "Circle of Protection: Black": "/src/assets/cards/enchantments/circle_of_protection_black.jpg",
            "Bone Shredder": "/src/assets/cards/creatures/bone_shredder.jpg",
            "Sylvan Library": "/src/assets/cards/enchantments/sylvan_library.jpg",
