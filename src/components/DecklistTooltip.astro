<div id="decklist-tooltip" style="display: none; position: fixed; z-index: 9999; pointer-events: none; width: 250px; border-radius: 4.75% / 3.5%; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
    <img id="decklist-tooltip-img" src="" alt="Card Preview" style="width: 100%; height: auto; display: block;" />
</div>

<script>
    const assetUrls = import.meta.glob('/src/assets/cards/**/*.{jpeg,jpg,png,gif,webp}', {
        eager: true,
        query: '?url',
        import: 'default'
    }) as Record<string, string>;

    // Cache for storing the oldest printing image URLs across page navigations
    const imageCache = new Map<string, string>();

    const initTooltips = () => {
        const tooltip = document.getElementById('decklist-tooltip');
        if (!tooltip) return;
        const tooltipImg = document.getElementById('decklist-tooltip-img') as HTMLImageElement;

        const localImages: Record<string, string> = {
            "Tormod's Crypt": "/src/assets/cards/artifacts/tormods_crypt.jpg",
