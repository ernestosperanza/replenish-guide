            "Blue Elemental Blast": "/src/assets/cards/instants/blue_elemental_blast.jpg",
            "Disenchant": "/src/assets/cards/instants/disenchant.jpg",
            "Nevinyrral's Disk": "/src/assets/cards/artifacts/nevinyrrals_disk.jpg",
            "Parallax Tide": "/src/assets/cards/enchantments/parallax_tide.jpg",
