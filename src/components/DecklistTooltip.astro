            "Illusionary Mask": "/src/assets/cards/matchups/stiflenought/illusionary_mask.jpg",
            "Terravore": "/src/assets/cards/matchups/terrageddon/terravore.jpg",
            "Armageddon": "/src/assets/cards/matchups/terrageddon/armageddon.jpg",
