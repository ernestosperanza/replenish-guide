            "Gloom": "/src/assets/cards/matchups/moneyball/gloom.jpg",
            "Grinning Demon": "/src/assets/cards/matchups/moneyball/grinning_demon.jpg",
            "Wretched Anurid": "/src/assets/cards/matchups/moneyball/wretched_anurid.jpg",
