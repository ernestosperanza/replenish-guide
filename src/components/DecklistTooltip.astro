            "Pernicious Deed": "/src/assets/cards/matchups/rock_and_midrange/pernicious_deed.jpg",
            "Spiritmonger": "/src/assets/cards/matchups/rock_and_midrange/spiritmonger.jpg",
            "Cabal Therapy": "/src/assets/cards/matchups/rock_and_midrange/cabal_therapy.jpg",
            "Vindicate": "/src/assets/cards/matchups/bw_control/vindicate.jpg",
            "Gerrard's Verdict": "/src/assets/cards/matchups/bw_control/gerrards_verdict.jpg",
            "Swords to Plowshares": "/src/assets/cards/instants/swords_to_plowshares.webp",
            "Upheaval": "/src/assets/cards/matchups/psychatog/upheaval.jpg",
            "Psychatog": "/src/assets/cards/matchups/psychatog/psychatog.jpg",
            "Circular Logic": "/src/assets/cards/matchups/psychatog/circular_logic.jpg",
            "Silver Knight": "/src/assets/cards/matchups/aggro_with_armageddon/silver_knight.jpg",
            "Mother Of Runes": "/src/assets/cards/matchups/aggro_with_armageddon/mother_of_runes.jpg",
            "Jackal Pup": "/src/assets/cards/matchups/sligh/jackal_pup.jpg",
            "Ball Lightning": "/src/assets/cards/matchups/sligh/ball_lightning.jpg",
            "Fireblast": "/src/assets/cards/matchups/sligh/fireblast.jpg",
            "Abeyance": "/src/assets/cards/instants/abeyance.jpg",
            "Hydroblast": "/src/assets/cards/instants/hydroblast.jpg",
            "Fact or Fiction": "/src/assets/cards/instants/fact_or_fiction.webp",
            "Mana Leak": "/src/assets/cards/instants/mana_leak.webp",
            "Intuition": "/src/assets/cards/instants/intuition.webp",
            "Arcane Denial": "/src/assets/cards/instants/arcane_denial.jpg",
            "Orim's Chant": "/src/assets/cards/instants/orims_chant.webp",
            "Tranquil Domain": "/src/assets/cards/instants/tranquil_domain.jpg",
            "Naturalize": "/src/assets/cards/instants/naturalize.jpg",
            "Frantic Search": "/src/assets/cards/instants/frantic_search.webp",
            "Meddling Mage": "/src/assets/cards/creatures/meddling_mage.webp",
            "Withered Wretch": "/src/assets/cards/creatures/withered_wretch.jpg",
            "Exalted Angel": "/src/assets/cards/creatures/exalted_angel.jpg"
        };

        // Function to find the oldest printing URL
        const fetchOldestImageUrl = async (cardName: string) => {
            const exactKey = Object.keys(localImages).find(k => k.toLowerCase() === cardName.toLowerCase());
            if (exactKey && localImages[exactKey]) {
                const path = localImages[exactKey];
                return assetUrls[path] || path;
            }
            if (imageCache.has(cardName)) return imageCache.get(cardName);
            try {
                const query = encodeURIComponent(`!"${cardName}"`);
                const res = await fetch(`https://api.scryfall.com/cards/search?q=${query}&order=released&dir=asc`);
                const data = await res.json();
                if (data && data.data && data.data.length > 0 && data.data[0].image_uris) {
                    const url = data.data[0].image_uris.normal;
                    imageCache.set(cardName, url);
                    return url;
                }
            } catch (e) {
                console.error("Error fetching oldest printing for", cardName, e);
            }
            // Fallback to default named API if search fails
            const fallbackUrl = `https://api.scryfall.com/cards/named?exact=${encodeURIComponent(cardName)}&format=image`;
            imageCache.set(cardName, fallbackUrl);
            return fallbackUrl;
        };

        const TOOLTIP_W = 250;
        const TOOLTIP_H = 350;
        let activeCard: HTMLElement | null = null;
        let lastPointerType = '';

        const positionAt = (clientX: number, clientY: number) => {
            const offset = 15;
            let x = clientX + offset;
            let y = clientY + offset;
            if (x + TOOLTIP_W > window.innerWidth) x = clientX - TOOLTIP_W - offset;
            if (y + TOOLTIP_H > window.innerHeight) y = clientY - TOOLTIP_H - offset;
            tooltip.style.left = `${Math.max(8, x)}px`;
            tooltip.style.top = `${Math.max(8, y)}px`;
        };

        // Anchor the tooltip to an element's box (used for keyboard focus & touch taps)
        const positionNear = (el: HTMLElement) => {
            const r = el.getBoundingClientRect();
            positionAt(r.left, r.bottom);
        };

        const showFor = async (el: HTMLElement) => {
            const cardName = el.getAttribute('data-card-name');
            if (!cardName) return;
            activeCard = el;
            tooltip.style.display = 'block';
            tooltipImg.src = ''; // Clear previous image
            const url = await fetchOldestImageUrl(cardName);
            // Guard against races: only paint if this card is still the active one
            if (tooltip.style.display === 'block' && activeCard === el) {
                tooltipImg.src = url!;
            }
        };

        const hide = () => {
            tooltip.style.display = 'none';
            tooltipImg.src = '';
            activeCard = null;
        };

        // Mouse (desktop hover)
        const handleMouseEnter = (e: MouseEvent) => {
            positionAt(e.clientX, e.clientY);
            showFor(e.currentTarget as HTMLElement);
        };
        const handleMouseMove = (e: MouseEvent) => positionAt(e.clientX, e.clientY);
        const handleMouseLeave = () => hide();

        // Keyboard (focus/blur). Skip when the focus came from a touch tap —
        // that case is handled by the click toggle below.
        const handleFocus = (e: FocusEvent) => {
            if (lastPointerType === 'touch') return;
            const el = e.currentTarget as HTMLElement;
            showFor(el);
            positionNear(el);
        };
        const handleBlur = () => hide();

        // Touch / click. Always prevent the "#" href from scrolling to top;
        // on touch, a tap toggles the preview open/closed.
        const handlePointerDown = (e: PointerEvent) => { lastPointerType = e.pointerType; };
        const handleClick = (e: MouseEvent) => {
            // On touch there's no hover, so a tap toggles the preview instead
            // of navigating. On mouse/keyboard, let the click open Scryfall.
            if (lastPointerType !== 'touch') return;
            e.preventDefault();
            const el = e.currentTarget as HTMLElement;
            if (activeCard === el && tooltip.style.display === 'block') {
                hide();
            } else {
                showFor(el);
                positionNear(el);
            }
        };

        const hoverItems = document.querySelectorAll<HTMLElement>('.card-hover');

        // Use IntersectionObserver to lazy load card images to prevent Scryfall rate limits
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const cardName = entry.target.getAttribute('data-card-name');
                    if (cardName && !imageCache.has(cardName)) {
                        fetchOldestImageUrl(cardName);
                    }
                    obs.unobserve(entry.target);
                }
            });
        }, { rootMargin: '200px' });

        hoverItems.forEach(item => {
            // Turn the placeholder "#" links into real Scryfall links: adds
            // utility (rulings/prices/art) and fixes link semantics for
            // screen readers. Desktop still gets the hover preview.
            const cardName = item.getAttribute('data-card-name');
            if (cardName) {
                item.setAttribute(
                    'href',
                    `https://scryfall.com/search?q=${encodeURIComponent(`!"${cardName}"`)}`
                );
                item.setAttribute('target', '_blank');
                item.setAttribute('rel', 'noopener noreferrer');
            }

            item.addEventListener('mouseenter', handleMouseEnter);
            item.addEventListener('mousemove', handleMouseMove);
            item.addEventListener('mouseleave', handleMouseLeave);
            item.addEventListener('focus', handleFocus);
            item.addEventListener('blur', handleBlur);
            item.addEventListener('pointerdown', handlePointerDown);
            item.addEventListener('click', handleClick);

            observer.observe(item);
        });

        // Close on Escape (bound once; survives Astro view transitions)
        if (!(window as any).__cardTooltipEscBound) {
            (window as any).__cardTooltipEscBound = true;
            document.addEventListener('keydown', (e) => {
                if (e.key !== 'Escape') return;
                const t = document.getElementById('decklist-tooltip');
                const img = document.getElementById('decklist-tooltip-img') as HTMLImageElement | null;
                if (t) t.style.display = 'none';
                if (img) img.src = '';
                (document.activeElement as HTMLElement | null)?.blur();
            });
        }
    };

    // Run immediately since Astro module scripts execute deferred (after DOM parsing)
    initTooltips();
    
    // Also run on Astro view transitions
    document.addEventListener('astro:page-load', () => {
        // Re-initialize if the tooltip element is lost
        if (!document.getElementById('decklist-tooltip')) return;
        initTooltips();
    });
</script>
