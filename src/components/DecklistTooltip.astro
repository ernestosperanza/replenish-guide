<div id="decklist-tooltip" style="display: none; position: fixed; z-index: 9999; pointer-events: none; width: 250px; border-radius: 4.75% / 3.5%; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
    <img id="decklist-tooltip-img" src="" alt="Card Preview" style="width: 100%; height: auto; display: block;" />
</div>

<script>
    const initTooltips = () => {
        const tooltip = document.getElementById('decklist-tooltip');
        if (!tooltip) return;
        const tooltipImg = document.getElementById('decklist-tooltip-img') as HTMLImageElement;
        
        // Cache for storing the oldest printing image URLs
        const imageCache = new Map<string, string>();

        const localImages: Record<string, string> = {
            "Tormod's Crypt": "/images/cards/artifacts/tormods_crypt.jpg",
            "Tsabo's Web": "/images/cards/artifacts/tsabos_web.jpg",
            "Defense Grid": "/images/cards/artifacts/defense_grid.jpg",
            "Phyrexian Furnace": "/images/cards/artifacts/phyrexian_furnace.jpg",
            "Parallax Wave": "/images/cards/enchantments/parallax_wave.webp",
            "Opalescence": "/images/cards/enchantments/opalescence.jpg",
            "Attunement": "/images/cards/enchantments/attunement.jpg",
            "Decree of Silence": "/images/cards/enchantments/decree_of_silence.jpg",
            "Seal of Cleansing": "/images/cards/enchantments/seal_of_cleansing.webp",
            "Sphere of Law": "/images/cards/enchantments/sphere_of_law.jpg",
            "Deep Analysis": "/images/cards/sorceries/deep_analysis.webp",
            "Replenish": "/images/cards/sorceries/replenish.jpg",
            "Wrath of God": "/images/cards/sorceries/wrath_of_god.webp",
            "Plains": "/images/cards/lands/plains.jpg",
            "Skycloud Expanse": "/images/cards/lands/skycloud_expanse.webp",
            "City of Traitors": "/images/cards/lands/city_of_traitors.webp",
            "Island": "/images/cards/lands/island.jpg",
            "Adarkar Wastes": "/images/cards/lands/adarkar_wastes.jpg",
            "Flooded Strand": "/images/cards/lands/flooded_strand.jpg",
            "Ancient Tomb": "/images/cards/lands/ancient_tomb.jpg",
            "Blue Elemental Blast": "/images/cards/instants/blue_elemental_blast.jpg",
            "Disenchant": "/images/cards/instants/disenchant.jpg",
            "Nevinyrral's Disk": "/images/cards/artifacts/nevinyrrals_disk.jpg",
            "Wirewood Symbiote": "/images/cards/matchups/elves/wirewood_symbiote.jpg",
            "Quirion Ranger": "/images/cards/matchups/elves/quirion_ranger.jpg",
            "Priest Of Titania": "/images/cards/matchups/elves/priest_of_titania.jpg",
            "Goblin Piledriver": "/images/cards/matchups/goblins/goblin_piledriver.jpg",
            "Goblin Ringleader": "/images/cards/matchups/goblins/goblin_ringleader.jpg",
            "Goblin Lackey": "/images/cards/matchups/goblins/goblin_lackey.jpg",
            "Survival of the Fittest": "/images/cards/matchups/devourer/survival_of_the_fittest.jpg",
            "Phyrexian Devourer": "/images/cards/matchups/devourer/phyrexian_devourer.jpg",
            "Sutured Ghoul": "/images/cards/matchups/devourer/sutured_ghoul.jpg",
            "Gloom": "/images/cards/matchups/moneyball/gloom.jpg",
            "Grinning Demon": "/images/cards/matchups/moneyball/grinning_demon.jpg",
            "Wretched Anurid": "/images/cards/matchups/moneyball/wretched_anurid.jpg",
            "Stone Rain": "/images/cards/matchups/rg_ponza/stone_rain.jpg",
            "Pillage": "/images/cards/matchups/rg_ponza/pillage.jpg",
            "Rishadan Port": "/images/cards/matchups/rg_ponza/rishadan_port.jpg",
            "Forsaken City": "/images/cards/matchups/stasis/forsaken_city.jpg",
            "Stasis": "/images/cards/matchups/stasis/stasis.jpg",
            "Black Vise": "/images/cards/matchups/stasis/black_vise.jpg",
            "Standstill": "/images/cards/matchups/landstill/standstill.jpg",
            "Counterspell": "/images/cards/matchups/landstill/counterspell.jpg",
            "Mishra's Factory": "/images/cards/matchups/landstill/mishras_factory.jpg",
            "Argothian Enchantress": "/images/cards/matchups/enchantress/argothian_enchantress.jpg",
            "Sterling Grove": "/images/cards/matchups/enchantress/sterling_grove.jpg",
            "Enchantress's Presence": "/images/cards/matchups/enchantress/enchantresss_presence.jpg",
            "Stifle": "/images/cards/matchups/stiflenought/stifle.jpg",
            "Phyrexian Dreadnought": "/images/cards/matchups/stiflenought/phyrexian_dreadnought.jpg",
            "Illusionary Mask": "/images/cards/matchups/stiflenought/illusionary_mask.jpg",
            "Terravore": "/images/cards/matchups/terrageddon/terravore.jpg",
            "Armageddon": "/images/cards/matchups/terrageddon/armageddon.jpg",
            "Oath Of Druids": "/images/cards/matchups/terrageddon/oath_of_druids.jpg",
            "Pernicious Deed": "/images/cards/matchups/rock_and_midrange/pernicious_deed.jpg",
            "Spiritmonger": "/images/cards/matchups/rock_and_midrange/spiritmonger.jpg",
            "Cabal Therapy": "/images/cards/matchups/rock_and_midrange/cabal_therapy.jpg",
            "Vindicate": "/images/cards/matchups/bw_control/vindicate.jpg",
            "Gerrard's Verdict": "/images/cards/matchups/bw_control/gerrards_verdict.jpg",
            "Swords to Plowshares": "/images/cards/instants/swords_to_plowshares.webp",
            "Upheaval": "/images/cards/matchups/psychatog/upheaval.jpg",
            "Psychatog": "/images/cards/matchups/psychatog/psychatog.jpg",
            "Circular Logic": "/images/cards/matchups/psychatog/circular_logic.jpg",
            "Silver Knight": "/images/cards/matchups/aggro_with_armageddon/silver_knight.jpg",
            "Mother Of Runes": "/images/cards/matchups/aggro_with_armageddon/mother_of_runes.jpg",
            "Jackal Pup": "/images/cards/matchups/sligh/jackal_pup.jpg",
            "Ball Lightning": "/images/cards/matchups/sligh/ball_lightning.jpg",
            "Fireblast": "/images/cards/matchups/sligh/fireblast.jpg",
            "Abeyance": "/images/cards/instants/abeyance.jpg",
            "Hydroblast": "/images/cards/instants/hydroblast.jpg",
            "Fact or Fiction": "/images/cards/instants/fact_or_fiction.webp",
            "Mana Leak": "/images/cards/instants/mana_leak.webp",
            "Intuition": "/images/cards/instants/intuition.webp",
            "Arcane Denial": "/images/cards/instants/arcane_denial.jpg",
            "Orim's Chant": "/images/cards/instants/orims_chant.webp",
            "Tranquil Domain": "/images/cards/instants/tranquil_domain.jpg",
            "Naturalize": "/images/cards/instants/naturalize.jpg",
            "Frantic Search": "/images/cards/instants/frantic_search.webp",
            "Meddling Mage": "/images/cards/creatures/meddling_mage.webp",
            "Withered Wretch": "/images/cards/creatures/withered_wretch.jpg",
            "Exalted Angel": "/images/cards/creatures/exalted_angel.jpg"
        };

        // Function to find the oldest printing URL
        const fetchOldestImageUrl = async (cardName: string) => {
            if (localImages[cardName]) return localImages[cardName];
            if (imageCache.has(cardName)) return imageCache.get(cardName);
            try {
                const query = encodeURIComponent(`!"${cardName}"`);
                const res = await fetch(`https://api.scryfall.com/cards/search?q=${query}&order=released&dir=asc`);
                const data = await res.json();
                if (data && data.data && data.data.length > 0 && data.data[0].image_uris) {
                    const url = data.data[0].image_uris.normal;
                    imageCache.set(cardName, url);
                    return url;
                }
            } catch (e) {
                console.error("Error fetching oldest printing for", cardName, e);
            }
            // Fallback to default named API if search fails
            const fallbackUrl = `https://api.scryfall.com/cards/named?exact=${encodeURIComponent(cardName)}&format=image`;
            imageCache.set(cardName, fallbackUrl);
            return fallbackUrl;
        };

        const handleMouseEnter = async (e: MouseEvent) => {
            const target = e.currentTarget as HTMLElement;
            const cardName = target.getAttribute('data-card-name');
            if (cardName) {
                tooltip.style.display = 'block';
                tooltipImg.src = ''; // Clear previous image
                
                const url = await fetchOldestImageUrl(cardName);
                if (tooltip.style.display === 'block') {
                    tooltipImg.src = url!;
                }
            }
        };

        const handleMouseMove = (e: MouseEvent) => {
            const xOffset = 15;
            const yOffset = 15;
            const tooltipWidth = 250;
            const tooltipHeight = 350;
            
            let x = e.clientX + xOffset;
            let y = e.clientY + yOffset;

            if (x + tooltipWidth > window.innerWidth) {
                x = e.clientX - tooltipWidth - xOffset;
            }
            if (y + tooltipHeight > window.innerHeight) {
                y = e.clientY - tooltipHeight - yOffset;
            }

            tooltip.style.left = `${x}px`;
            tooltip.style.top = `${y}px`;
        };

        const handleMouseLeave = () => {
            tooltip.style.display = 'none';
            tooltipImg.src = '';
        };

        const hoverItems = document.querySelectorAll('.card-hover');
        hoverItems.forEach(item => {
            item.addEventListener('mouseenter', handleMouseEnter);
            item.addEventListener('mousemove', handleMouseMove);
            item.addEventListener('mouseleave', handleMouseLeave);
            
            // Preload the URL in the background
            const cardName = item.getAttribute('data-card-name');
            if (cardName && !imageCache.has(cardName)) {
                setTimeout(() => fetchOldestImageUrl(cardName), Math.random() * 2000);
            }
        });
    };

    // Run immediately since Astro module scripts execute deferred (after DOM parsing)
    initTooltips();
    
    // Also run on Astro view transitions
    document.addEventListener('astro:page-load', () => {
        // Re-initialize if the tooltip element is lost
        if (!document.getElementById('decklist-tooltip')) return;
        initTooltips();
    });
</script>
