            "Ball Lightning": "/src/assets/cards/matchups/sligh/ball_lightning.jpg",
            "Fireblast": "/src/assets/cards/matchups/sligh/fireblast.jpg",
            "Abeyance": "/src/assets/cards/instants/abeyance.jpg",
            "Hydroblast": "/src/assets/cards/instants/hydroblast.jpg",
            "Fact or Fiction": "/src/assets/cards/instants/fact_or_fiction.webp",
            "Mana Leak": "/src/assets/cards/instants/mana_leak.webp",
            "Intuition": "/src/assets/cards/instants/intuition.webp",
            "Arcane Denial": "/src/assets/cards/instants/arcane_denial.jpg",
            "Orim's Chant": "/src/assets/cards/instants/orims_chant.webp",
            "Tranquil Domain": "/src/assets/cards/instants/tranquil_domain.jpg",
            "Naturalize": "/src/assets/cards/instants/naturalize.jpg",
            "Frantic Search": "/src/assets/cards/instants/frantic_search.webp",
            "Meddling Mage": "/src/assets/cards/creatures/meddling_mage.webp",
            "Withered Wretch": "/src/assets/cards/creatures/withered_wretch.jpg",
            "Exalted Angel": "/src/assets/cards/creatures/exalted_angel.jpg"
        };

        // Function to find the oldest printing URL
        const fetchOldestImageUrl = async (cardName: string) => {
            const exactKey = Object.keys(localImages).find(k => k.toLowerCase() === cardName.toLowerCase());
            if (exactKey && localImages[exactKey]) {
                const path = localImages[exactKey];
                return assetUrls[path] || path;
            }
            if (imageCache.has(cardName)) return imageCache.get(cardName);
            try {
                const query = encodeURIComponent(`!"${cardName}"`);
                const res = await fetch(`https://api.scryfall.com/cards/search?q=${query}&order=released&dir=asc`);
                const data = await res.json();
                if (data && data.data && data.data.length > 0 && data.data[0].image_uris) {
                    const url = data.data[0].image_uris.normal;
                    imageCache.set(cardName, url);
                    return url;
                }
            } catch (e) {
                console.error("Error fetching oldest printing for", cardName, e);
            }
            // Fallback to default named API if search fails
            const fallbackUrl = `https://api.scryfall.com/cards/named?exact=${encodeURIComponent(cardName)}&format=image`;
            imageCache.set(cardName, fallbackUrl);
            return fallbackUrl;
        };

        const handleMouseEnter = async (e: MouseEvent) => {
            const target = e.currentTarget as HTMLElement;
            const cardName = target.getAttribute('data-card-name');
            if (cardName) {
                tooltip.style.display = 'block';
                tooltipImg.src = ''; // Clear previous image
                
                const url = await fetchOldestImageUrl(cardName);
                if (tooltip.style.display === 'block') {
                    tooltipImg.src = url!;
                }
            }
        };

        const handleMouseMove = (e: MouseEvent) => {
            const xOffset = 15;
            const yOffset = 15;
            const tooltipWidth = 250;
            const tooltipHeight = 350;
            
            let x = e.clientX + xOffset;
            let y = e.clientY + yOffset;

            if (x + tooltipWidth > window.innerWidth) {
                x = e.clientX - tooltipWidth - xOffset;
            }
            if (y + tooltipHeight > window.innerHeight) {
                y = e.clientY - tooltipHeight - yOffset;
            }

            tooltip.style.left = `${x}px`;
            tooltip.style.top = `${y}px`;
        };

        const handleMouseLeave = () => {
            tooltip.style.display = 'none';
            tooltipImg.src = '';
        };

        const hoverItems = document.querySelectorAll('.card-hover');
        hoverItems.forEach(item => {
            item.addEventListener('mouseenter', handleMouseEnter);
            item.addEventListener('mousemove', handleMouseMove);
            item.addEventListener('mouseleave', handleMouseLeave);
            
            // Preload the URL in the background
            const cardName = item.getAttribute('data-card-name');
            if (cardName && !imageCache.has(cardName)) {
                setTimeout(() => fetchOldestImageUrl(cardName), Math.random() * 2000);
            }
        });
    };

    // Run immediately since Astro module scripts execute deferred (after DOM parsing)
    initTooltips();
    
    // Also run on Astro view transitions
    document.addEventListener('astro:page-load', () => {
        // Re-initialize if the tooltip element is lost
        if (!document.getElementById('decklist-tooltip')) return;
        initTooltips();
    });
</script>
