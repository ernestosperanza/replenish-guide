            "Sterling Grove": "/src/assets/cards/matchups/enchantress/sterling_grove.jpg",
            "Enchantress's Presence": "/src/assets/cards/matchups/enchantress/enchantresss_presence.jpg",
            "Stifle": "/src/assets/cards/matchups/stiflenought/stifle.jpg",
