---
import { Flex } from "webcoreui/astro";
export interface Props {
    cards: { src: string; alt: string }[];
    width?: string;
}

const { cards, width = "150px" } = Astro.props;
---

<Flex
    gap="lg"
    wrap="wrap"
    alignment={{ horizontal: "center" }}
    className="card-grid"
    style="margin-bottom: 2.5rem; margin-top: 1.5rem;"
>
    {
        cards.map((card) => (
            <img
                src={card.src}
                alt={card.alt}
                style={`width: ${width}; border-radius: 4.75% / 3.5%; border: 1px solid var(--w-color-primary-50);`}
            />
        ))
    }
</Flex>
