---
import { FLAT_NAV } from "../config/nav";

const currentPath = Astro.url.pathname;
// Strip trailing slash if any, but keep / if it's the root
const normalizedPath =
    currentPath.endsWith("/") && currentPath.length > 1
        ? currentPath.slice(0, -1)
        : currentPath;

const currentIndex = FLAT_NAV.findIndex(
    (item) =>
        item.href === normalizedPath ||
        (item.href !== "/" && normalizedPath.startsWith(item.href + "/")),
);

const prev = currentIndex > 0 ? FLAT_NAV[currentIndex - 1] : null;
const next =
    currentIndex !== -1 && currentIndex < FLAT_NAV.length - 1
        ? FLAT_NAV[currentIndex + 1]
        : null;
---

<div
    class="pagination-nav"
    style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--w-color-primary-50); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;"
>
    <div style="flex: 1;">
        {
            prev && (
                <a
                    href={prev.href}
                    class="pagination-link"
                    style="display: inline-block; text-decoration: none; padding: 0.85rem 1.6rem; border-radius: var(--w-sm-radius); color: var(--w-color-primary-10);"
                >
                    <div style="font-size: 0.85rem; color: var(--w-color-primary-30); margin-bottom: 0.25rem;">
                        Previous
                    </div>
                    <div style="font-size: 1.1rem; font-weight: 500;">
                        &larr; {prev.name}
                    </div>
                </a>
            )
        }
    </div>
    <div style="flex: 1; text-align: right;">
        {
            next && (
                <a
                    href={next.href}
                    class="pagination-link"
                    style="display: inline-block; text-decoration: none; padding: 0.85rem 1.6rem; border-radius: var(--w-sm-radius); color: var(--w-color-primary-10);"
                >
                    <div style="font-size: 0.85rem; color: var(--w-color-primary-30); margin-bottom: 0.25rem;">
                        Next
                    </div>
                    <div style="font-size: 1.1rem; font-weight: 500;">
                        {next.name} &rarr;
                    </div>
                </a>
            )
        }
    </div>
</div>

<style lang="scss">
    .pagination-link {
        border: 1px solid transparent;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }
    .pagination-link:hover {
        background-color: var(--w-color-primary-60);
        border-color: var(--w-color-primary-50);
    }
</style>
