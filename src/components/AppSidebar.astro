---
import { Sidebar } from "webcoreui/astro";

const currentPath = Astro.url.pathname;

const sidebarGroups = [
    {
        title: "Overview",
        items: [
            { name: "Introduction", href: "/", active: currentPath === "/" },
            { name: "History", href: "/history", active: currentPath.startsWith("/history") },
        ],
    },
    {
        title: "Deckbuilding",
        items: [
            { name: "Maindeck", href: "/analysis", active: currentPath.startsWith("/analysis") },
            { name: "Sideboard", href: "/sideboard", active: currentPath.startsWith("/sideboard") },
            { name: "Lists", href: "/deck", active: currentPath.startsWith("/deck") },
        ],
    },
    {
        title: "Gameplay",
        items: [
            { name: "Mechanics", href: "/mechanics", active: currentPath.startsWith("/mechanics") },
            { name: "Intuition Guide", href: "/intuition", active: currentPath.startsWith("/intuition") },
            { name: "Strategy", href: "/strategy", active: currentPath.startsWith("/strategy") },
            { name: "Mulligan Guide", href: "/mulligan", active: currentPath.startsWith("/mulligan") },
        ],
    },
    {
        title: "Matchups",
        items: [
            { name: "Matchup Analysis", href: "/matchups", active: currentPath.startsWith("/matchups") },
            { name: "Sideboard Matrix", href: "/sideboard-matrix", active: currentPath.startsWith("/sideboard-matrix") },
        ],
    },
    {
        title: "Wrapping Up",
        items: [
            { name: "Conclusion", href: "/conclusion", active: currentPath.startsWith("/conclusion") },
        ],
    },
];
---

<div id="sidebar-overlay" class="sidebar-overlay"></div>
<div id="sidebar-wrapper" class="sidebar-wrapper">
    <Sidebar groups={sidebarGroups} className="sidebar" />
</div>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const wrapper = document.getElementById('sidebar-wrapper');
    const overlay = document.getElementById('sidebar-overlay');

    if (btn && wrapper && overlay) {
        btn.addEventListener('click', () => {
            wrapper.classList.toggle('mobile-open');
            overlay.classList.toggle('mobile-open');
        });
        
        overlay.addEventListener('click', () => {
            wrapper.classList.remove('mobile-open');
            overlay.classList.remove('mobile-open');
        });
    }
</script>

<style lang="scss" is:global>
    .sidebar-wrapper {
        position: fixed;
        left: -250px;
        top: 60px;
        width: 260px;
        height: calc(100vh - 60px);
        z-index: 90;
        /* Transición más rápida y responsiva */
        transition: left 0.15s ease-out;

        /* Hit area para que sea fácil abrirlo en desktop */
        &::after {
            content: '';
            position: absolute;
            top: 0;
            right: -20px;
            width: 30px;
            height: 100%;
            cursor: pointer;
            
            @media (max-width: 768px) {
                display: none;
            }
        }

        @media (max-width: 768px) {
            /* Hide completely on mobile to prevent the 10px strip and shadow from overlapping text */
            left: -300px; 
        }

        @media (min-width: 769px) {
            &:hover {
                left: 0;
            }
        }

        &.mobile-open {
            left: 0;
        }
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        z-index: 80;
        
        &.mobile-open {
            display: block;
        }
    }

    .sidebar {
        width: 100%;
        height: 100%;
        background-color: var(--w-color-primary-70);
        border-right: 1px solid var(--w-color-primary-50);
        overflow-y: auto;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.2);
        padding: 1rem;
    }
</style>
