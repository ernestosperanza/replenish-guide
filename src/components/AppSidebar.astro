---
import { Sidebar } from "webcoreui/astro";

const currentPath = Astro.url.pathname;

const sidebarGroups = [
    {
        title: "Overview",
        items: [
            { name: "Introduction", href: "/", active: currentPath === "/" },
            { name: "History", href: "/history", active: currentPath.startsWith("/history") },
        ],
    },
    {
        title: "Deckbuilding",
        items: [
            { name: "Maindeck", href: "/analysis", active: currentPath.startsWith("/analysis") },
            { name: "Sideboard", href: "/sideboard", active: currentPath.startsWith("/sideboard") },
            { name: "Lists", href: "/deck", active: currentPath.startsWith("/deck") },
        ],
    },
    {
        title: "Gameplay",
        items: [
            { name: "Mechanics", href: "/mechanics", active: currentPath.startsWith("/mechanics") },
            { name: "Intuition Guide", href: "/intuition", active: currentPath.startsWith("/intuition") },
            { name: "Strategy", href: "/strategy", active: currentPath.startsWith("/strategy") },
            { name: "Matchups", href: "/matchups", active: currentPath.startsWith("/matchups") },
        ],
    },
    {
        title: "Wrapping Up",
        items: [
            { name: "Conclusion", href: "/conclusion", active: currentPath.startsWith("/conclusion") },
        ],
    },
];
---

<div class="sidebar-wrapper">
    <Sidebar groups={sidebarGroups} className="sidebar" />
</div>

<style lang="scss" is:global>
    .sidebar-wrapper {
        position: fixed;
        left: -250px;
        top: 60px;
        width: 260px;
        height: calc(100vh - 60px);
        z-index: 90;
        /* Transición más rápida y responsiva */
        transition: left 0.15s ease-out;

        /* Hit area para que sea fácil abrirlo */
        &::after {
            content: '';
            position: absolute;
            top: 0;
            right: -20px;
            width: 30px;
            height: 100%;
            cursor: pointer;
        }

        &:hover {
            left: 0;
        }
    }

    .sidebar {
        width: 100%;
        height: 100%;
        background-color: var(--w-color-primary-70);
        border-right: 1px solid var(--w-color-primary-50);
        overflow-y: auto;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.2);
        padding: 1rem;
    }
</style>
