---
import FeaturedImage from "./FeaturedImage.astro";
import { Card } from "webcoreui/astro";

export interface Props {
    title: string;
    description?: string;
    imageSrc?: string;
    imageAlt?: string;
    imageCaption?: string;
    isCard?: boolean;
}

const {
    title,
    description,
    imageSrc,
    imageAlt,
    imageCaption
} = Astro.props;
---

<header style="margin-bottom: 3rem;">
    <Card>
        <h1
            style="margin-top: 0; border-bottom: 1px solid var(--w-color-primary-50); font-size: clamp(2rem, 6vw, 3rem); letter-spacing: -0.02em; margin-bottom: 1rem; padding-bottom: 0.5rem;"
        >
            {title}
        </h1>

        {
            description && (
                <p
                    style="font-size: 1.15rem; color: var(--w-color-primary-20); margin-bottom: 2rem; line-height: 1.6; max-width: 800px;"
                    set:html={description}
                />
            )
        }

        {
            imageSrc && (
                <FeaturedImage
                    src={imageSrc}
                    alt={imageAlt || ""}
                    caption={imageCaption}
                    isCard={false}
                />
            )
        }
    </Card>
</header>
