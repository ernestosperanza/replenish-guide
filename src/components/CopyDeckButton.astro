---
import { Button } from "webcoreui/astro";
export interface Props {
    decklist: string;
}
const { decklist } = Astro.props;
---
<div class="copy-deck-wrapper" data-decklist={decklist} style="display: inline-flex; align-items: center;">
    <button type="button" class="copy-btn" aria-label="Copy MTGO List" title="Copy MTGO List">
        📋
    </button>
</div>

<style>
    .copy-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        font-size: 1.2rem;
        padding: 0.25rem;
        transition: transform 0.2s ease, opacity 0.2s ease;
        opacity: 0.7;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .copy-btn:hover {
        opacity: 1;
        transform: scale(1.1);
    }
</style>

<script>
    const initCopyButtons = () => {
        document.querySelectorAll('.copy-deck-wrapper').forEach(wrapper => {
            const btn = wrapper.querySelector('.copy-btn');
            if (btn && !btn.hasAttribute('data-copy-initialized')) {
                btn.setAttribute('data-copy-initialized', 'true');
                btn.addEventListener('click', (e) => {
                    e.stopPropagation(); // Prevent closing details if placed in summary
                    navigator.clipboard.writeText(wrapper.getAttribute('data-decklist') || '');
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '✅';
                    setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                });
            }
        });
    };

    // Run on initial load and after view transitions
    initCopyButtons();
    document.addEventListener('astro:page-load', initCopyButtons);
</script>
