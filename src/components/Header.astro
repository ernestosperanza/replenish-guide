<header class="top-nav">
    <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">☰</button>
    <div class="logo">
        <a href="/" style="text-decoration: none; color: inherit;">
            <strong style="margin-left: 1rem;">Replenish Guide</strong>
        </a>
    </div>
</header>

<style lang="scss">
    .top-nav {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        padding: 0 var(--w-space-xl);
        background-color: #fdfaf6; /* Fallback light parchment color */
        background-image: url('/images/texture.jpg');
        background-repeat: repeat;
        background-size: auto;
        background-position: top left;
        border-bottom: 2px solid #111; /* Classic MTG black border */
        box-shadow: inset 0 -2px 5px rgba(0,0,0,0.2), 0 2px 10px rgba(0,0,0,0.5); /* Bevel/depth effect */
        height: 45px;
        position: sticky;
        top: 0;
        z-index: 100;
        
        @media (max-width: 768px) {
            padding: 0 var(--w-space-md);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: var(--w-space-sm);
            
            @media (max-width: 768px) {
                display: none;
            }
        }

        a {
            color: #111; /* Dark text for light MTG card background */
            text-shadow: 1px 1px 0px rgba(255, 255, 255, 0.5); /* Slight white highlight like classic card text */
            font-size: 1.1rem;
            letter-spacing: 0.02em;
            &:hover {
                color: #000;
            }
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #111;
            cursor: pointer;
            padding: 0.5rem;
            margin-right: 1rem;
            margin-left: -0.5rem;
            
            @media (max-width: 768px) {
                display: block;
            }
        }
    }
</style>
