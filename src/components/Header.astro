---

<header class="top-nav">
    <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">☰</button>
    <div class="logo">
        <a href="/" style="text-decoration: none; color: inherit;">
            <strong style="margin-left: 1rem;">Replenish Guide</strong>
        </a>
    </div>
</header>

<style lang="scss">
    .top-nav {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        padding: 0 var(--w-space-xl);
        background-color: rgba(30, 30, 32, 0.65); /* Dark translucent background */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        height: 55px;
        position: sticky;
        top: 0;
        z-index: 100;
        transition: background-color 0.3s ease;
        
        @media (max-width: 768px) {
            padding: 0 var(--w-space-md);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: var(--w-space-sm);
            
            @media (max-width: 768px) {
                display: none;
            }
        }

        a {
            color: #111; /* Dark text for light MTG card background */
            text-shadow: 1px 1px 0px rgba(255, 255, 255, 0.5); /* Slight white highlight like classic card text */
            font-size: 1.1rem;
            letter-spacing: 0.02em;
            &:hover {
                color: #000;
            }
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #111;
            cursor: pointer;
            padding: 0.5rem;
            margin-right: 1rem;
            margin-left: -0.5rem;
            transition: transform 0.2s ease;
            
            &:hover {
                transform: scale(1.1);
            }
            
            @media (max-width: 768px) {
                display: block;
            }
        }
    }
</style>
