---
import { ThemeSwitcher, Icon } from "webcoreui/astro";
---

<header class="top-nav">
    <div class="logo">
        <a href="/" style="text-decoration: none; color: inherit;">
            <strong style="margin-left: 1rem;">Replenish Guide</strong>
        </a>
    </div>
</header>

<style lang="scss">
    .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--w-space-md) var(--w-space-xl);
        background-color: var(--w-color-primary-60);
        border-bottom: 1px solid var(--w-color-primary-50);
        height: 60px;
        position: sticky;
        top: 0;
        z-index: 100;

        .logo {
            display: flex;
            align-items: center;
            gap: var(--w-space-sm);
        }

        a {
            color: var(--w-color-primary-20);
            &:hover {
                color: var(--w-color-primary);
            }
        }
    }
</style>
