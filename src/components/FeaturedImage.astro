---
import { Image } from "astro:assets";

export interface Props {
    src: string;
    alt: string;
    caption?: string;
    isCard?: boolean;
}

const { src, alt, caption, isCard = false } = Astro.props;

const maxWidth = "400px";
const maxHeight = "auto";
const borderRadius = isCard ? "4.75% / 3.5%" : "var(--w-lg-radius)";

const isLocalAsset = src.startsWith("/src/assets/");
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/banners/*.{jpeg,jpg,png,gif,webp}');

// Astro components can use top-level await!
let importedImage: ImageMetadata | null = null;
if (isLocalAsset && images[src]) {
    importedImage = (await images[src]()).default;
}
---

<figure
    style="margin: 3rem auto; display: flex; flex-direction: column; align-items: center; text-align: center;"
>
    {
        importedImage ? (
            <Image
                src={importedImage}
                alt={alt}
                width={800}
                style={`max-width: ${maxWidth}; width: 100%; height: auto; max-height: ${maxHeight}; border-radius: ${borderRadius}; border: 1px solid var(--w-color-primary-50); display: block;`}
            />
        ) : (
            <img
                src={src}
                alt={alt}
                style={`max-width: ${maxWidth}; width: 100%; height: auto; max-height: ${maxHeight}; border-radius: ${borderRadius}; border: 1px solid var(--w-color-primary-50); display: block;`}
            />
        )
    }
    {
        caption && (
            <figcaption style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--w-color-primary-40); font-style: italic;">
                {caption}
            </figcaption>
        )
    }
</figure>
